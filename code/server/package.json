{
  "name": "onboardiq-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "seed": "node src/db/seed.js",
    "test:api": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "test:rules": "vitest run -c vitest.pure.config.js tests/rules.test.js",
    "test:sample": "vitest run -c vitest.pure.config.js tests/sample.test.js",
    "batch": "node scripts/batch.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "csv-parse": "^7.0.3",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "rollup": "npm:@rollup/wasm-node@^4.65.0",
    "esbuild": "npm:esbuild-wasm@^0.28.2"
  }
}
