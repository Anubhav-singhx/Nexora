# Copy to .env (npm run setup does this for you). Never commit .env.
PORT=3001
NODE_ENV=development

# Local PostgreSQL started by: docker compose up -d db
DATABASE_URL=postgres://onboardiq:onboardiq@localhost:5432/onboardiq
# Used only by npm run test:api. The database name MUST end in _test (it is wiped on every run).
TEST_DATABASE_URL=postgres://onboardiq:onboardiq@localhost:5432/onboardiq_test

# Use a long random string. Anything starting with "change_me" is refused when NODE_ENV=production.
JWT_SECRET=change_me_dev_only_secret_value
JWT_EXPIRES_IN=8h

# Relative paths are resolved from the repository root. Folder is gitignored.
UPLOAD_DIR=uploads

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Password given to the 3 seeded demo users (applicant / officer / checker)
DEMO_PASSWORD=Demo@1234

# Extraction provider: "mock" reads the extraction_mock file (long format doc_id,field_name,value,confidence) by document id; "ai" calls AI_EXTRACTION_URL. Switch with no code change.
EXTRACTION_PROVIDER=mock
MOCK_EXTRACTION_FILE=data/sample/extraction_mock.csv
AI_EXTRACTION_URL=
AI_EXTRACTION_API_KEY=

# Mock core-banking service. The key protects POST /api/v1/mock-core-banking/accounts (backend-to-backend only).
# Leave CORE_BANKING_URL empty to call the built-in mock in-process; set it to point at another service.
CORE_BANKING_API_KEY=dev-core-banking-key-change-me
CORE_BANKING_URL=

# Service key for POST /api/v1/documents/:docId/extract when the backend itself calls the extraction service (header x-service-key).
EXTRACTION_SERVICE_KEY=dev-extraction-service-key-change-me

# The application date stamped on new applications is today's date in IST. Set this ONLY to reproduce the case
# document's worked examples (they are all dated 2026-03-04); leave it empty for normal use.
APPLICATION_DATE=
